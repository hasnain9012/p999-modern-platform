generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String   @default("🎮")
  description String   @db.Text
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  games       Game[]
}

model Game {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  shortDescription String   @db.Text
  description     String   @db.Text
  image           String
  downloadUrl     String   @default("#download")
  version         String   @default("1.0.0")
  size            String   @default("Unknown")
  developer       String   @default("Publisher")
  updatedLabel    String   @default("August 2026")
  hot             Boolean  @default(false)
  featured        Boolean  @default(false)
  status          PublishStatus @default(PUBLISHED)
  sortOrder       Int      @default(0)
  features        Json
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  seo             GameSEO?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categoryId, status, sortOrder])
  @@index([status, hot, featured])
  @@index([title])
}

model GameSEO {
  id              String @id @default(cuid())
  gameId          String @unique
  seoTitle        String?
  metaDescription String? @db.Text
  canonicalUrl    String?
  focusKeyword    String?
  ogTitle         String?
  ogDescription   String? @db.Text
  ogImage         String?
  robots          String @default("index,follow")
  schemaType      String @default("VideoGame")
  game            Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SEO_MANAGER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
