# Neon pooled connection used by the Next.js runtime.
# Copy the pooled URL from Neon and keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection used by Prisma CLI migrations.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"

# Public site URL used by canonical URLs / SEO.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin bootstrap account. Used only by prisma/seed.ts.
ADMIN_NAME="Site Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD"

# Used to sign the admin HTTP-only cookie. Generate a long random value.
AUTH_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"
